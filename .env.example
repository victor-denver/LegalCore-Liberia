# Supabase — copy to .env.local and fill in.
# Both values are safe to ship to the browser: the publishable key is scoped by Row Level Security.
# Find them in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
