# OPTIONAL — you do not need this file to run or deploy LegalCore.
#
# The project's Supabase connection is built into src/lib/supabase.ts, so a fresh
# clone and a new deployment both work with zero configuration. Sign-in behaves the
# same on localhost as it does in production.
#
# Set these only to point a build at a DIFFERENT Supabase project (a staging copy,
# your own fork, a rotated key). When present they override the built-in defaults.
# Copy this file to .env.local and fill it in.
#
# Find the values in Supabase Dashboard → Project Settings → API.
# Both are safe to ship to the browser: the publishable key is scoped by Row Level
# Security and grants no privileges on its own.
#
# NEVER put the secret / service-role key in a VITE_ variable. Anything prefixed
# VITE_ is compiled into JavaScript that every visitor downloads.

# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
